# Port d'écoute du proxy
PROXY_PORT=3100

# URL du backend Convex (site HTTP, pas l'URL .cloud) — voir VITE_CONVEX_SITE_URL dans app/.env.local
CONVEX_SITE_URL=https://wonderful-shark-673.eu-west-1.convex.site

# Clé API — identique à la variable FINANCIAL_API_KEY du déploiement Convex (npx convex env set FINANCIAL_API_KEY …)
FINANCIAL_API_KEY=remplacer-par-une-cle-aleatoire-de-64-caracteres

# IPs autorisées, séparées par des virgules (vide = pas de restriction)
ALLOWED_IPS=

# Requêtes max par minute et par IP
RATE_LIMIT_RPM=30
